APP_NAME=Revilo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=revilo
DB_USERNAME=revilo
DB_PASSWORD=
# Used only by the optional MySQL Docker container.
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
BCRYPT_ROUNDS=12

# Local previews. Choose smtp only after configuring a delivery provider.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=preview@example.test
MAIL_FROM_NAME=Revilo

TEST_CHECKOUT_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
SHOP_CONTACT_EMAIL=
VITE_APP_NAME=Revilo
