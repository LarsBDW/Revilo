APP_NAME=Revilo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Hosting account: larsbdw. Confirm the exact database/user names in the dashboard.
APP_URL=https://larsbdw.alwaysdata.net
# Use * only where all web requests pass through the hosting provider's proxy,
# which replaces X-Forwarded-Proto. Clear/change this when moving hosts.
TRUSTED_PROXIES="*"
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

# alwaysdata's MySQL service is MariaDB; use Laravel's compatible mysql connection.
DB_CONNECTION=mysql
DB_HOST=mysql-larsbdw.alwaysdata.net
DB_PORT=3306
DB_DATABASE=larsbdw_shop
DB_USERNAME=larsbdw_app
DB_PASSWORD=""
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_DAILY_DAYS=3
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# Public preview: no payments or outbound messages until those are configured.
TEST_CHECKOUT_ENABLED=false
PUBLIC_PREVIEW_ENABLED=true
MAIL_MAILER=log
MAIL_FROM_ADDRESS=preview@example.test
MAIL_FROM_NAME=Revilo
SHOP_CONTACT_EMAIL=

# Configure these privately after adding the hosted Google OAuth callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://larsbdw.alwaysdata.net/auth/google/callback
VITE_APP_NAME=Revilo
